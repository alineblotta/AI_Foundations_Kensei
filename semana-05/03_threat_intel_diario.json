    {
      "parameters": {
        "jsCode": "const agora = Date.now();\nconst vinteQuatroHorasEmMs = 24 * 60 * 60 * 1000;\nconst limiteData = agora - vinteQuatroHorasEmMs;\n\nconst resultados = [];\n\nfor (const item of items) {\n    const dataNoticia = new Date(item.json.pubDate).getTime();\n    if (!isNaN(dataNoticia) && dataNoticia > limiteData) {\n        resultados.push({\n            json: {\n                title: item.json.title,\n                link: item.json.link,\n                pubDate: item.json.pubDate\n            }\n        });\n    }\n}\n\nif (resultados.length === 0) {\n    return [{ json: { noNews: true } }];\n}\nreturn resultados;"
      },
